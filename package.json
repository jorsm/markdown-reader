{
    "name": "markdown-reader",
    "displayName": "Markdown Reader",
    "description": "Listen to a Markdown file while you follow it with your eyes: click a sentence and it is read aloud from there, highlighted as it goes.",
    "publisher": "jorsm",
    "version": "0.0.1",
    "private": true,
    "license": "MIT",
    "repository": {
        "type": "git",
        "url": "https://github.com/jorsm/markdown-reader"
    },
    "engines": {
        "vscode": "^1.110.0"
    },
    "categories": [
        "Other"
    ],
    "activationEvents": [],
    "main": "./out/extension.js",
    "contributes": {
        "commands": [
            {
                "command": "markdownReader.open",
                "title": "Read Aloud",
                "category": "Markdown Reader",
                "icon": "$(unmute)"
            },
            {
                "command": "markdownReader.setApiKey",
                "title": "Set API Key",
                "category": "Markdown Reader"
            }
        ],
        "menus": {
            "editor/title": [
                {
                    "command": "markdownReader.open",
                    "when": "editorLangId == markdown || activeWebviewPanelId == 'markdown.preview'",
                    "group": "navigation"
                }
            ],
            "explorer/context": [
                {
                    "command": "markdownReader.open",
                    "when": "resourceLangId == markdown",
                    "group": "navigation"
                }
            ]
        },
        "configuration": {
            "title": "Markdown Reader",
            "properties": {
                "markdownReader.model": {
                    "type": "string",
                    "enum": [
                        "inworld-tts-2-flash",
                        "inworld-tts-2"
                    ],
                    "enumDescriptions": [
                        "Fastest and cheapest (default).",
                        "Higher quality, slower and more expensive."
                    ],
                    "default": "inworld-tts-2-flash",
                    "description": "Inworld TTS model used to read documents."
                },
                "markdownReader.audioOutput": {
                    "type": "string",
                    "enum": [
                        "auto",
                        "ffplay",
                        "webview"
                    ],
                    "enumDescriptions": [
                        "ffplay when it is on the PATH, otherwise the panel.",
                        "Always ffplay (FFmpeg), run by the extension; needed where the panel has no sound, such as the snap build of VS Code.",
                        "Always the panel's own audio element."
                    ],
                    "default": "auto",
                    "description": "Where audio is played. Reload the window after changing it."
                },
                "markdownReader.pricePerMillionCharacters": {
                    "type": "object",
                    "additionalProperties": {
                        "type": "number",
                        "minimum": 0
                    },
                    "default": {
                        "inworld-tts-2-flash": 15,
                        "inworld-tts-2": 25
                    },
                    "description": "USD per million billed characters, per model, used to estimate spend. Inworld's on-demand list prices on 21 Oct 2026; correct them if your plan or the prices change."
                },
                "markdownReader.lookahead": {
                    "type": "integer",
                    "default": 6,
                    "minimum": 1,
                    "maximum": 30,
                    "description": "How many units ahead of the playing one are prepared."
                },
                "markdownReader.concurrency": {
                    "type": "integer",
                    "default": 3,
                    "minimum": 1,
                    "maximum": 8,
                    "description": "How many synthesis requests run at the same time."
                }
            }
        }
    },
    "scripts": {
        "vscode:prepublish": "npm run bundle",
        "compile": "tsc -p ./",
        "watch": "tsc -watch -p ./",
        "clean": "rimraf out",
        "bundle": "npm run clean && esbuild ./src/extension.ts --bundle --outfile=out/extension.js --external:vscode --format=cjs --platform=node --minify",
        "test": "npm run compile && node --test 'test/**/*.test.js'",
        "lint": "eslint src --max-warnings 0",
        "format": "prettier --write .",
        "format:check": "prettier --check .",
        "check": "npm run format:check && npm run lint && npm test",
        "prepare": "husky"
    },
    "lint-staged": {
        "*": "prettier --check --ignore-unknown"
    },
    "devDependencies": {
        "@eslint/js": "^9.39.5",
        "@types/markdown-it": "^14.2.0",
        "@types/node": "22.x",
        "@types/vscode": "^1.110.0",
        "@typescript-eslint/eslint-plugin": "^8.42.0",
        "@typescript-eslint/parser": "^8.42.0",
        "esbuild": "^0.27.4",
        "eslint": "^9.34.0",
        "eslint-config-prettier": "10.1.8",
        "eslint-plugin-jsdoc": "^65.4.0",
        "eslint-plugin-tsdoc": "^0.5.4",
        "husky": "^9.1.7",
        "lint-staged": "^17.6.0",
        "prettier": "3.9.10",
        "prettier-plugin-multiline-arrays": "4.1.11",
        "rimraf": "^6.1.3",
        "typescript": "^5.9.2"
    },
    "dependencies": {
        "markdown-it": "^14.3.3"
    }
}
